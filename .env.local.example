# ── Google Maps ──────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Enable: Maps JavaScript API + Visualization library
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# ── WebSocket Server ──────────────────────────────────────────────
# URL of the Socket.IO backend (live crime data stream)
NEXT_PUBLIC_WS_URL=http://localhost:4000

# ── Backend API ───────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ── Database (for full backend) ───────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/sentineliq
# OR MongoDB:
# MONGODB_URI=mongodb://localhost:27017/sentineliq

# ── ML Model API ──────────────────────────────────────────────────
# Python FastAPI prediction server
ML_API_URL=http://localhost:8000

# ── Auth (optional) ───────────────────────────────────────────────
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=http://localhost:3000
